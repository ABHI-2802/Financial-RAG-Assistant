# ─────────────────────────────────────────────
# Financial RAG Assistant — Environment Config
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── LLM Backend ──────────────────────────────
# Options: "ollama" | "openai" | "mock"
LLM_BACKEND=ollama

# Ollama settings (used when LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenAI settings (used when LLM_BACKEND=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── Embedding Model ──────────────────────────
# Local sentence-transformers model name
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Vector Store ─────────────────────────────
# Options: "faiss" | "chroma"
VECTOR_STORE=faiss
VECTOR_STORE_PATH=data/processed/vector_store

# ── Chunking ─────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ────────────────────────────────
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3

# ── API ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── Logging ──────────────────────────────────
LOG_LEVEL=INFO
